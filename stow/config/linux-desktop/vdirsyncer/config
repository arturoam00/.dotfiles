# An example configuration for vdirsyncer.
#
# Move it to ~/.vdirsyncer/config or ~/.config/vdirsyncer/config and edit it.
# Run `vdirsyncer --help` for CLI usage.
#
# Optional parameters are commented out.
# This file doesn't document all available parameters, see
# http://vdirsyncer.pimutils.org/ for the rest of them.

[general]
# A folder where vdirsyncer can store some metadata about each pair.
status_path = "~/.local/share/vdirsyncer/status/"

# CARDDAV
[pair personal_contacts]
# A `[pair <name>]` block defines two storages `a` and `b` that should be
# synchronized. The definition of these storages follows in `[storage <name>]`
# blocks. This is similar to accounts in OfflineIMAP.
a = "personal_contacts_local"
b = "personal_contacts_remote"

# Synchronize all collections that can be found.
# You need to run `vdirsyncer discover` if new calendars/addressbooks are added
# on the server.

collections = ["from a", "from b"]

# Synchronize the "display name" property into a local file (~/.contacts/displayname).
metadata = ["displayname"]

# To resolve a conflict the following values are possible:
#   `null` - abort when collisions occur (default)
#   `"a wins"` - assume a's items to be more up-to-date
#   `"b wins"` - assume b's items to be more up-to-date
#conflict_resolution = null

[storage personal_contacts_local]
# A storage references actual data on a remote server or on the local disk.
# Similar to repositories in OfflineIMAP.
type = "filesystem"
path = "~/Sync/Phone/contacts/"
fileext = ".vcf"

[storage personal_contacts_remote]
type = "carddav"
url = "https://calendar.arturoam.com/"
username = "artu"
password.fetch = ["command", "pass", "calendar.arturoam.com"]

# CALDAV
[pair personal_calendar]
a = "personal_calendar_local"
b = "personal_calendar_remote"
collections = ["from a", "from b"]

# Calendars also have a color property
metadata = ["displayname", "color"]

[storage personal_calendar_local]
type = "filesystem"
path = "~/Sync/Phone/calendars/"
fileext = ".ics"

[storage personal_calendar_remote]
type = "caldav"
url = "https://calendar.arturoam.com/"
username = "artu"
password.fetch = ["command", "pass", "calendar.arturoam.com"]

[pair holidays_nl]
a = "holidays_nl_public"
b = "holidays_nl_private"
collections = null

[storage holidays_nl_public]
type = "http"
# The URL to your iCalendar file.
url = "https://www.officeholidays.com/ics/netherlands"

[storage holidays_nl_private]
type = "caldav"
# The direct URL to your calendar.
url = "https://calendar.arturoam.com/artu/4f3e44c2-3095-323d-b495-0603cc190925"
# The credentials to your CalDAV server
username = "artu"
password.fetch = ["command", "pass", "calendar.arturoam.com"]


[pair italki]
a = "italki_public"
b = "italki_private"
collections = null

[storage italki_public]
type = "http"
# The URL to your iCalendar file.
url = "https://www.italki.com/calendar/58KVDyCeAQGYDkxiI4Z6DB/ics"

[storage italki_private]
type = "caldav"
# The direct URL to your calendar.
url = "https://calendar.arturoam.com/artu/02d9b74a-61b3-d236-e74f-4ec6232a7515"
# The credentials to your CalDAV server
username = "artu"
password.fetch = ["command", "pass", "calendar.arturoam.com"]
