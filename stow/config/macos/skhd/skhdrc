# Minimal Sway-like keymap for yabai. Option/Alt is the window-manager mod.

# Modes also update the Sway-style mode indicator in SketchyBar.
:: default    : sketchybar --set mode drawing=off
:: resize  @  : sketchybar --set mode drawing=on label=resize
:: special @  : sketchybar --set mode drawing=on label=screenshot

# Applications and config reload
alt - return         : open -na /Applications/Alacritty.app
alt - d              : open -a Spotlight
alt + shift - c      : yabai --restart-service; sketchybar --reload; skhd -r

# Session and power controls. These use macOS's native lock/logout actions and
# a small confirmation menu for restart or shutdown.
alt + shift - z      : skhd -k "ctrl + cmd - q"
alt + shift - e      : skhd -k "shift + cmd - q"
alt + shift - p      : ~/.config/skhd/power-menu.sh

# Close through yabai when the window has a native close button. Borderless
# windows (notably Alacritty) need the application's standard Cmd-W fallback.
alt + shift - q      : yabai -m window --close || skhd -k "cmd - w"

# Focus a window, then a stack member, then the adjacent display. This keeps
# hjkl navigation continuous across monitors without a separate display mode.
alt - h              : yabai -m window --focus west  || yabai -m display --focus west
alt - j              : yabai -m window --focus south || yabai -m window --focus stack.next || yabai -m display --focus south
alt - k              : yabai -m window --focus north || yabai -m window --focus stack.prev || yabai -m display --focus north
alt - l              : yabai -m window --focus east  || yabai -m display --focus east
alt - left           : yabai -m window --focus west  || yabai -m display --focus west
alt - down           : yabai -m window --focus south || yabai -m window --focus stack.next || yabai -m display --focus south
alt - up             : yabai -m window --focus north || yabai -m window --focus stack.prev || yabai -m display --focus north
alt - right          : yabai -m window --focus east  || yabai -m display --focus east

# Move the focused window through the BSP tree.
alt + shift - h      : yabai -m window --warp west
alt + shift - j      : yabai -m window --warp south
alt + shift - k      : yabai -m window --warp north
alt + shift - l      : yabai -m window --warp east
alt + shift - left   : yabai -m window --warp west
alt + shift - down   : yabai -m window --warp south
alt + shift - up     : yabai -m window --warp north
alt + shift - right  : yabai -m window --warp east

# Workspaces 1-10
alt - 1              : yabai -m space --focus 1
alt - 2              : yabai -m space --focus 2
alt - 3              : yabai -m space --focus 3
alt - 4              : yabai -m space --focus 4
alt - 5              : yabai -m space --focus 5
alt - 6              : yabai -m space --focus 6
alt - 7              : yabai -m space --focus 7
alt - 8              : yabai -m space --focus 8
alt - 9              : yabai -m space --focus 9
alt - 0              : yabai -m space --focus 10

alt + shift - 1      : yabai -m window --space 1
alt + shift - 2      : yabai -m window --space 2
alt + shift - 3      : yabai -m window --space 3
alt + shift - 4      : yabai -m window --space 4
alt + shift - 5      : yabai -m window --space 5
alt + shift - 6      : yabai -m window --space 6
alt + shift - 7      : yabai -m window --space 7
alt + shift - 8      : yabai -m window --space 8
alt + shift - 9      : yabai -m window --space 9
alt + shift - 0      : yabai -m window --space 10

# Layout controls. Local stack insertion preserves the surrounding BSP tree;
# yabai cannot visually distinguish Sway's stacking and tabbed presentations.
alt - b              : yabai -m space --layout bsp; yabai -m window --insert east
alt - v              : yabai -m space --layout bsp; yabai -m window --insert south
alt - s              : yabai -m space --layout bsp; yabai -m window --insert stack
alt - w              : yabai -m space --layout bsp; yabai -m window --insert stack
alt - e              : yabai -m space --layout bsp; yabai -m window --toggle split
alt - f              : yabai -m window --toggle zoom-fullscreen
alt + shift - space  : yabai -m window --toggle float
alt - space          : ~/.config/skhd/focus-mode.sh
alt - a              : yabai -m window --toggle zoom-parent

# Resize mode: h/k shrink and j/l grow by 10px, matching the Sway config.
alt - r              ; resize
resize < h           : yabai -m window --resize left:10:0 || yabai -m window --resize right:-10:0
resize < j           : yabai -m window --resize bottom:0:10 || yabai -m window --resize top:0:-10
resize < k           : yabai -m window --resize top:0:10 || yabai -m window --resize bottom:0:-10
resize < l           : yabai -m window --resize right:10:0 || yabai -m window --resize left:-10:0
resize < left        : yabai -m window --resize left:10:0 || yabai -m window --resize right:-10:0
resize < down        : yabai -m window --resize bottom:0:10 || yabai -m window --resize top:0:-10
resize < up          : yabai -m window --resize top:0:10 || yabai -m window --resize bottom:0:-10
resize < right       : yabai -m window --resize right:10:0 || yabai -m window --resize left:-10:0
resize < return      ; default
resize < escape      ; default

# Screenshot mode: color meter, selection/fullscreen to clipboard, or save a
# selection to the Desktop. Each action returns to the default mode.
alt - z              ; special
special < c          : open -a "Digital Color Meter"; skhd -k "escape"
special < s          : screencapture -ic; skhd -k "escape"
special < shift - s  : screencapture -c; skhd -k "escape"
special < a          : ~/.config/skhd/screenshot.sh selection; skhd -k "escape"
special < return     ; default
special < escape     ; default
