: "${XDG_CONFIG_HOME:=$HOME/.config}"
export XDG_CONFIG_HOME

[[ -r "$XDG_CONFIG_HOME/shell/env.sh" ]] &&
    source "$XDG_CONFIG_HOME/shell/env.sh"
[[ -r "$HOME/.env" ]] && source "$HOME/.env"
[[ -r "$HOME/.secrets" ]] && source "$HOME/.secrets"
[[ -r "$XDG_CONFIG_HOME/shell/functions.sh" ]] &&
    source "$XDG_CONFIG_HOME/shell/functions.sh"
[[ -r "$XDG_CONFIG_HOME/shell/paths.sh" ]] &&
    source "$XDG_CONFIG_HOME/shell/paths.sh"

if [[ -n "${GRIM_DEFAULT_DIR:-}" ]]; then
    mkdir -p "$GRIM_DEFAULT_DIR"
fi

[[ -r "$HOME/.bashrc" ]] && source "$HOME/.bashrc"

